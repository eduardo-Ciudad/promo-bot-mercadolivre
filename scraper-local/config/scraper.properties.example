# Copie este arquivo para config/scraper.properties para sobrescrever os valores padrao.
# A URL do endpoint tambem pode ser definida por SCRAPER_VPS_ENDPOINT_URL.
ingestao.endpoint-url=

scraping.headless=true
# A pagina de ofertas usa paginacao classica; %d sera substituido pelo numero da pagina.
scraping.base-url-template=https://www.mercadolivre.com.br/ofertas?page=%d
scraping.max-produtos=20
scraping.max-paginas=10
# Pausa de estabilidade entre navegacoes de pagina.
scraping.page-delay-ms=1000
scraping.desconto-minimo=10
scraping.timeout-segundos=30

scheduler.hora-inicio=07:00
scheduler.hora-fim=20:00
scheduler.intervalo-minutos=30
scheduler.timezone=America/Sao_Paulo
scheduler.executar-ao-iniciar=false

# Obrigatoria e aceita apenas via variavel de ambiente:
# SCRAPER_INGESTAO_API_KEY=sua-chave
